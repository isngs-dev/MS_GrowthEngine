# Optional: forward every valid lead to this URL (CRM / Zapier / Make / n8n webhook)
# LEAD_WEBHOOK_URL=https://example.com/webhook
# Public site URL used for Open Graph tags
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Fixed meeting room (Google Meet / Zoom / Teams). If unset, each booking gets a unique Jitsi room.
# MEETING_URL=https://meet.google.com/xxx-xxxx-xxx

# Google Calendar (creates the event + Google Meet link for booked calls)
# OAuth2 client + refresh token of the calendar owner, scope https://www.googleapis.com/auth/calendar.events
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx
# GOOGLE_REFRESH_TOKEN=1//xxxx
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_SEND_INVITES=true   (set false if you only want our own e-mail, not Google's invite)

# Who gets the internal "call booked" e-mail (default: kaustubh.b1@isngs.com)
# TEAM_NOTIFY_EMAIL=kaustubh.b1@isngs.com

# Confirmation e-mails go out through the Gmail API. Without these the form still works but no e-mail is sent.
# Needs the Gmail API enabled, a refresh token granted the gmail.send scope (run /api/google/connect with
# GOOGLE_SETUP=1), and the From address set up as a "Send mail as" alias of the connected mailbox.
# MAIL_FROM_EMAIL=info@isngs.com
# MAIL_FROM_NAME=MS GROWTH ENGINE

# Day-before reminder job: protects /api/reminders (call it hourly with "Authorization: Bearer <secret>")
# CRON_SECRET=a-long-random-string
